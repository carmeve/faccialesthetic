---
import Layout from '../../layouts/Layout.astro';
import site from '../../data/site.json';
import courses from '../../data/courses.json';

export function getStaticPaths() {
  return courses.map(course => ({ params: { slug: course.slug }, props: { course } }));
}

const { course } = Astro.props;
const title = `Curso de ${course.name.toLocaleLowerCase('es-CO')} en Medellín`;
const description = `Curso presencial de ${course.name} en Medellín con Facciale Sthetic. Consulta temario, requisitos profesionales, duración y próximas fechas.`;
const message = `Hola, me interesa el curso de ${course.name} en Medellín. ¿Me pueden compartir el temario, los requisitos, la duración, las fechas y el precio?`;
const contactUrl = `https://wa.me/${site.phone}?text=${encodeURIComponent(message)}`;
const courseSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: title,
  description: course.description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  inLanguage: 'es-CO',
  provider: {
    '@type': 'Organization',
    '@id': `${new URL('/', Astro.site).href}#organization`,
    name: site.name,
  },
}).replace(/</g, '\\u003c');
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={courseSchema} />
  <section class="page-heading shell">
    <a class="text-link" href="/cursos/">← Todos los cursos</a>
    <p class="eyebrow">{course.category} / Formación presencial</p>
    <h1>{title}</h1>
    <p>{course.description}</p>
    <a class="button" href={contactUrl} target="_blank" rel="noopener">Solicitar información por WhatsApp ↗</a>
  </section>
  <section class="section shell">
    <div class="section-top"><h2>Qué confirmar antes de inscribirte</h2></div>
    <p>{course.question} Confirma con el equipo la duración, las fechas, el precio, el alcance de la práctica y si se entrega certificado.</p>
    <p>La formación se ofrece de forma presencial en Medellín. Confirma la sede al inscribirte y consulta la <a class="text-link" href="/contacto/">página de contacto y ubicación</a>.</p>
  </section>
</Layout>
