---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import courses from '../data/courses.json';

const categories = [...new Set(courses.map(course => course.category))];
const contactUrl = `https://wa.me/${site.phone}?text=${encodeURIComponent('Hola, quiero conocer la oferta de cursos presenciales de Facciale Sthetic en Medellín.')}`;
---

<Layout
  title="Cursos presenciales de estética facial y corporal en Medellín"
  description="Explora 15 cursos presenciales de Facciale Sthetic en Medellín, desde toxina botulínica y ácido hialurónico hasta micropigmentación y estética corporal."
>
  <section class="page-heading shell">
    <p class="eyebrow">Facciale / Formación</p>
    <h1>Cursos presenciales de estética facial y corporal en Medellín</h1>
    <p>Formación práctica, avanzada y personalizada en armonización facial, cuidado de la piel y estética corporal. Explora el catálogo y consulta qué curso se ajusta a tu perfil profesional.</p>
    <a class="button" href={contactUrl} target="_blank" rel="noopener">Consultar fechas y requisitos ↗</a>
  </section>
  {categories.map(category => (
    <section class="section shell">
      <div class="section-top"><h2>{category}</h2></div>
      <div class="service-grid">
        {courses.filter(course => course.category === category).map(course => (
          <article class="service-card">
            <h3><a href={`/cursos/${course.slug}/`}>{course.name}</a></h3>
            <p>{course.description}</p>
            <a class="card-bottom" href={`/cursos/${course.slug}/`} aria-label={`Ver curso de ${course.name}`}>Ver curso <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </section>
  ))}
  <section class="section shell">
    <div class="section-top"><h2>Antes de inscribirte</h2></div>
    <p>Confirma con Facciale Sthetic el temario vigente, los requisitos de ingreso, la duración, el precio y si el curso ofrece certificado. Los requisitos para las formaciones sobre procedimientos invasivos dependen del perfil profesional.</p>
    <p>Consulta la sede y las indicaciones para llegar en <a class="text-link" href="/contacto/">Contacto y ubicación en Medellín</a>.</p>
  </section>
</Layout>
