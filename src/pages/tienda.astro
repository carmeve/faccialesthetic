---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';

interface CatalogProduct {
  name: string;
  price: number;
  image: string;
  description?: string;
  gallery?: string[] | null;
  category?: string;
  status: 'published' | 'draft' | 'unavailable';
}

const categoryFiles = import.meta.glob<{ name: string }>('../content/catalogo/categorias/*.json', { eager: true, import: 'default' });
const productFiles = import.meta.glob<CatalogProduct>('../content/catalogo/productos/*.json', { eager: true, import: 'default' });
const photos = import.meta.glob<ImageMetadata>('../assets/productos/*.{avif,webp,jpg,jpeg,png}', { eager: true, import: 'default' });

const categories = Object.entries(categoryFiles)
  .map(([path, category]) => ({ id: path.replace('../', 'src/'), name: category.name }))
  .sort((a, b) => a.name.localeCompare(b.name, 'es'));
const categoryNames = new Map(categories.map(category => [category.id, category.name]));
const publishedProducts = Object.entries(productFiles)
  .filter(([, product]) => product.status === 'published' || product.status === 'unavailable')
  .map(([path, product]) => ({
    ...product,
    id: path.split('/').at(-1)!.replace(/\.json$/, ''),
    photo: photos[product.image.replace('/images/productos/', '../assets/productos/')],
    galleryPhotos: (product.gallery ?? []).map(image => photos[image.replace('/images/productos/', '../assets/productos/')]).filter(Boolean),
  }))
  .sort((a, b) => a.name.localeCompare(b.name, 'es'));
const products = publishedProducts
  .filter(product => product.status === 'published')
  .map(({ id, name, price }) => ({ id, name, price }));
const money=(n:number)=>new Intl.NumberFormat('es-CO',{style:'currency',currency:'COP',maximumFractionDigits:0}).format(n);
---
<Layout title="Tienda" description="Consulta los productos de Facciale Sthetic y solicita información de disponibilidad y compra."><section class="page-heading shell"><p class="eyebrow">Facciale / TIENDA</p><h1>Un espacio para<br/><em>seguir cuidándote.</em></h1><p>Explora el catálogo y consulta con el equipo antes de comprar.</p></section><section class="shell section shop-grid"><div>
  {categories.length > 0 && <div class="catalog-filter">
    <label for="catalog-category">Categoría</label>
    <select id="catalog-category">
      <option value="">Todas las categorías</option>
      {categories.map(category => <option value={category.id}>{category.name}</option>)}
    </select>
  </div>}
  <div class="product-grid">
    {publishedProducts.map(product => (
      <article class="product-card" data-catalog-product data-category={product.category ?? ''}>
        {product.photo && <div class="product-image">
          <Image src={product.photo} alt={product.name} width={480} format="avif" loading="lazy" decoding="async" />
        </div>}
        {product.category && categoryNames.has(product.category) && <p class="eyebrow">{categoryNames.get(product.category)}</p>}
        <h2>{product.name}</h2>
        {product.description && <p class="product-description">{product.description}</p>}
        <p class="price">{money(product.price)} <small>COP</small></p>
        {product.galleryPhotos.length > 0 && <details class="product-gallery">
          <summary>Ver más fotos</summary>
          <div>{product.galleryPhotos.map((photo, index) => (
            <Image src={photo} alt={`${product.name}, foto ${index + 2}`} width={240} format="avif" loading="lazy" decoding="async" />
          ))}</div>
        </details>}
        {product.status === 'published'
          ? <button type="button" class="button add-product" data-id={product.id}>Agregar al carrito <span aria-hidden="true">+</span></button>
          : <p class="product-availability">No disponible</p>}
      </article>
    ))}
  </div>
  <p id="catalog-empty" role="status" hidden={publishedProducts.length > 0}>No hay productos para mostrar en esta categoría.</p>
</div><aside class="basket"><p class="eyebrow">TU SELECCIÓN</p><h2>Consulta de compra</h2><div id="cart-items" aria-live="polite"></div><p class="total">Total de referencia <strong id="cart-total">$ 0</strong></p><a id="cart-send" class="button" href={`https://wa.me/${site.phone}`} target="_blank" rel="noopener">Consultar por WhatsApp ↗</a><button id="cart-clear" class="text-link" type="button">Vaciar selección</button><p class="fine">Los precios se tomaron del catálogo actual y deben confirmarse. Disponibilidad, envío y condiciones se acuerdan con el equipo. Esta selección no crea un pedido ni reserva inventario.</p></aside></section><section class="shell payment-note"><h3>Pagos en línea: próxima etapa</h3><p>Wompi · Sistecrédito · Addi</p><p class="fine">Integraciones previstas para la nueva tienda. Aún no están habilitadas en esta propuesta.</p></section><script define:vars={{products,phone:site.phone}} type="module">
import {readCart,changeQuantity,cartTotal} from '/cart.js';
let cart=readCart(localStorage,products);const money=n=>new Intl.NumberFormat('es-CO',{style:'currency',currency:'COP',maximumFractionDigits:0}).format(n);
function render(){const box=document.querySelector('#cart-items');box.replaceChildren();if(!Object.keys(cart).length){const p=document.createElement('p');p.textContent='Aún no has seleccionado productos.';box.append(p);}for(const p of products){const quantity=cart[p.id];if(!quantity)continue;const row=document.createElement('div');row.className='cart-row';const label=document.createElement('span');label.textContent=p.name+' × '+quantity;const remove=document.createElement('button');remove.type='button';remove.textContent='−';remove.setAttribute('aria-label','Quitar una unidad de '+p.name);remove.onclick=()=>{cart=changeQuantity(cart,p.id,-1,products);render();};row.append(label,remove);box.append(row);}document.querySelector('#cart-total').textContent=money(cartTotal(cart,products));const lines=products.filter(p=>cart[p.id]).map(p=>`${p.name} × ${cart[p.id]}`);const msg=lines.length?'Hola, quisiera confirmar precio, disponibilidad y formas de pago de: '+lines.join(', ')+'.':'Hola, quiero información sobre la tienda de Facciale Sthetic.';document.querySelector('#cart-send').href='https://wa.me/'+phone+'?text='+encodeURIComponent(msg);try{localStorage.setItem('facciale-cart',JSON.stringify(cart));}catch{}}
document.querySelectorAll('.add-product').forEach(b=>b.addEventListener('click',()=>{cart=changeQuantity(cart,b.dataset.id,1,products);render();}));document.querySelector('#cart-clear').addEventListener('click',()=>{cart={};render();});render();
</script>
<script>
  const category = document.querySelector<HTMLSelectElement>('#catalog-category');
  const cards = document.querySelectorAll<HTMLElement>('[data-catalog-product]');
  const empty = document.querySelector<HTMLElement>('#catalog-empty');

  category?.addEventListener('change', () => {
    let visibleCount = 0;
    for (const card of cards) {
      card.hidden = Boolean(category.value && card.dataset.category !== category.value);
      if (!card.hidden) visibleCount++;
    }
    if (empty) empty.hidden = visibleCount > 0;
  });
</script>
</Layout>

<style>
  .catalog-filter { display: grid; gap: 6px; margin-bottom: 24px; }
  .catalog-filter label { font-weight: 700; font-size: 14px; }
  .catalog-filter select {
    width: min(100%, 300px);
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--ink);
    background: var(--paper);
    font: inherit;
  }
  .product-card[hidden] { display: none; }
  .product-description { white-space: pre-line; }
  .product-gallery { margin-bottom: 15px; }
  .product-gallery summary { cursor: pointer; font-weight: 600; }
  .product-gallery > div { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 8px; }
  .product-gallery img { width: 100%; height: auto; }
  .product-availability { font-weight: 700; }
</style>
