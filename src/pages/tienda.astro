---
import Layout from '../layouts/Layout.astro';import products from '../data/products.json';import site from '../data/site.json';
const money=(n:number)=>new Intl.NumberFormat('es-CO',{style:'currency',currency:'COP',maximumFractionDigits:0}).format(n);
---
<Layout title="Tienda" description="Consulta los productos de Facciale Sthetic y solicita información de disponibilidad y compra."><section class="page-heading shell"><p class="eyebrow">Facciale / TIENDA</p><h1>Un espacio para<br/><em>seguir cuidándote.</em></h1><p>Explora el catálogo y consulta con el equipo antes de comprar.</p></section><section class="shell section shop-grid"><div class="product-grid">{products.map(p=><article class="product-card"><div class="product-image"><img src={p.image} alt={p.name} width="300" height="300"/></div><h2>{p.name}</h2><p class="price">{money(p.price)} <small>COP</small></p><button class="button add-product" data-id={p.id}>Añadir a mi consulta <span>+</span></button></article>)}</div><aside class="basket"><p class="eyebrow">TU SELECCIÓN</p><h2>Consulta de compra</h2><div id="cart-items" aria-live="polite"></div><p class="total">Total de referencia <strong id="cart-total">$ 0</strong></p><a id="cart-send" class="button" href={`https://wa.me/${site.phone}`} target="_blank" rel="noopener">Consultar por WhatsApp ↗</a><button id="cart-clear" class="text-link" type="button">Vaciar selección</button><p class="fine">Los precios se tomaron del catálogo actual y deben confirmarse. Disponibilidad, envío y condiciones se acuerdan con el equipo. Esta selección no crea un pedido ni reserva inventario.</p></aside></section><section class="shell payment-note"><h3>Pagos en línea: próxima etapa</h3><p>Wompi · Sistecrédito · Addi</p><p class="fine">Integraciones previstas para la nueva tienda. Aún no están habilitadas en esta propuesta.</p></section><script define:vars={{products,phone:site.phone}} type="module">
import {readCart,changeQuantity,cartTotal} from '/cart.js';
let cart=readCart(localStorage,products);const money=n=>new Intl.NumberFormat('es-CO',{style:'currency',currency:'COP',maximumFractionDigits:0}).format(n);
function render(){const box=document.querySelector('#cart-items');box.replaceChildren();if(!Object.keys(cart).length){const p=document.createElement('p');p.textContent='Aún no has seleccionado productos.';box.append(p);}for(const p of products){const quantity=cart[p.id];if(!quantity)continue;const row=document.createElement('div');row.className='cart-row';const label=document.createElement('span');label.textContent=p.name+' × '+quantity;const remove=document.createElement('button');remove.type='button';remove.textContent='−';remove.setAttribute('aria-label','Quitar una unidad de '+p.name);remove.onclick=()=>{cart=changeQuantity(cart,p.id,-1,products);render();};row.append(label,remove);box.append(row);}document.querySelector('#cart-total').textContent=money(cartTotal(cart,products));const lines=products.filter(p=>cart[p.id]).map(p=>`${p.name} × ${cart[p.id]}`);const msg=lines.length?'Hola, quisiera confirmar precio, disponibilidad y formas de pago de: '+lines.join(', ')+'.':'Hola, quiero información sobre la tienda de Facciale Sthetic.';document.querySelector('#cart-send').href='https://wa.me/'+phone+'?text='+encodeURIComponent(msg);try{localStorage.setItem('facciale-cart',JSON.stringify(cart));}catch{}}
document.querySelectorAll('.add-product').forEach(b=>b.addEventListener('click',()=>{cart=changeQuantity(cart,b.dataset.id,1,products);render();}));document.querySelector('#cart-clear').addEventListener('click',()=>{cart={};render();});render();
</script></Layout>
