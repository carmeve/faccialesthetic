---
import '../styles/global.css';
import site from '../data/site.json';
const {title, description=site.intro} = Astro.props;
const indexable=import.meta.env.PUBLIC_INDEXABLE==='true';
const canonical = new URL(Astro.url.pathname, Astro.site);
const brandUrl = new URL('/', Astro.site).href;
const facebook = 'https://www.facebook.com/faccialesthetic';
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${brandUrl}#organization`,
  name: site.name,
  url: brandUrl,
  logo: {'@type': 'ImageObject', url: new URL('/images/logo.png', Astro.site).href, width: 300, height: 300},
  telephone: `+${site.phone}`,
  email: site.email,
  address: {'@type': 'PostalAddress', streetAddress: site.address, addressLocality: 'Medellín', addressRegion: 'Antioquia', addressCountry: 'CO'},
  sameAs: [site.instagram, facebook],
};
const brandJson = JSON.stringify(organization).replace(/</g, '\\u003c');
const nav=[['/','Inicio'],['/servicios/','Tratamientos'],['/cursos/','Cursos'],['/nosotros/','Nuestro equipo'],['/contacto/','Contacto']];
const wa=`https://wa.me/${site.phone}?text=${encodeURIComponent('Hola, quiero solicitar una valoración en Facciale Sthetic.')}`;
---
<!doctype html><html lang="es-CO"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | Facciale Sthetic</title><meta name="description" content={description}/><meta name="robots" content={indexable?'index, follow':'noindex, nofollow'}/><link rel="canonical" href={canonical}/><meta property="og:title" content={`${title} | Facciale Sthetic`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/images/logo.png',Astro.site)}/><link rel="icon" href="/images/logo.png"/><script type="application/ld+json" set:html={brandJson} /></head>
<body>
<a class="skip" href="#contenido">Saltar al contenido</a>
{!indexable && <div class="preview-note">Propuesta de diseño · Versión de revisión · Los pagos en línea aún no están habilitados</div>}
<header class="header"><div class="shell nav-row"><a class="brand" href="/" aria-label="Facciale Sthetic, inicio"><span class="brand-logo" aria-hidden="true"><img src="/images/logo.png" alt="" width="300" height="300" /></span><span>Facciale <em>Sthetic</em><small>ESTÉTICA · SONRISA · BIENESTAR</small></span></a><button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">Menú <span>☰</span></button><nav id="main-nav" aria-label="Navegación principal">{nav.map(([href,label])=><a href={href} aria-current={(href==='/'?Astro.url.pathname==='/':Astro.url.pathname.startsWith(href))?'page':undefined}>{label}</a>)}</nav><a class="shop-link" href="/tienda/">Tienda <span aria-hidden="true">↗</span></a></div></header>
<main id="contenido"><slot/></main>
<section class="closing"><div class="shell closing-inner"><div><p class="eyebrow">TU PRÓXIMO PASO</p><h2>Todo comienza<br/>con una conversación.</h2></div><div><p>Cuéntanos qué necesitas.<br/>Te ayudamos a encontrar por dónde empezar.</p><a class="button light" href={wa} target="_blank" rel="noopener">Solicitar valoración <span>↗</span></a></div></div></section>
<footer><div class="shell footer-grid"><div><a class="brand" href="/">Facciale <em>Sthetic</em></a><p>Cuidamos tu sonrisa, tu piel<br/>y tu bienestar emocional.</p></div><div><h3>Explora</h3><a href="/servicios/">Tratamientos</a><a href="/cursos/">Formación</a><a href="/nosotros/">Nuestro equipo</a><a href="/tienda/">Tienda</a></div><div><h3>Visítanos</h3><p>{site.address}<br/>{site.city}</p><a href="/contacto/">Cómo llegar ↗</a></div><div><h3>Conversemos</h3><a href={`tel:+${site.phone}`}>{site.phoneLabel}</a><a href={`mailto:${site.email}`}>{site.email}</a><a href={site.instagram} target="_blank" rel="noopener">Instagram ↗</a><a href={facebook} target="_blank" rel="noopener">Facebook ↗</a></div></div><div class="shell footer-bottom"><span>© {new Date().getFullYear()} Facciale Sthetic</span><span>La indicación de tratamientos requiere valoración profesional individual.</span></div></footer>
<script>
const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');
toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!open));document.querySelector('#main-nav')?.classList.toggle('open',!open);});
document.addEventListener('keydown',(e)=>{if(e.key==='Escape'){toggle?.setAttribute('aria-expanded','false');document.querySelector('#main-nav')?.classList.remove('open');}});
</script>
</body></html>
